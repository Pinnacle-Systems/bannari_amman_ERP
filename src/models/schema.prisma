  label                     String
  type                      String                    @default("number") // number, text, array
  parentRelation            String?
  fieldPath                 String?
  aggregation               String?
  active                    Boolean                   @default(true)
  ApprovalConfigConditions  ApprovalConfigCondition[] @relation("sourceField")
