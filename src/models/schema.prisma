  id               Int               @id @default(autoincrement())
  approvalConfigId Int
  ApprovalConfig   ApprovalConfig    @relation(fields: [approvalConfigId], references: [id], onDelete: Cascade)
  fieldId          Int
  Field            ApprovalRuleField @relation("sourceField", fields: [fieldId], references: [id])

  operatorId Int
  Operator   ApprovalRuleOperator @relation(fields: [operatorId], references: [id])

  valueType String @default("STATIC") // 'STATIC' or 'DYNAMIC'

  value String?

  compareFieldId Int?
  CompareField   ApprovalRuleField? @relation("compareField", fields: [compareFieldId], references: [id])
}

